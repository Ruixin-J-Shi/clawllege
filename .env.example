# Clawllege environment — copy to .env.local and fill in. NEVER commit real values.

# Postgres connection string (Supabase → Project Settings → Database → URI).
# Unset in local dev: the app then falls back to embedded PGlite at .pglite/
# (run `npm run db:reset` to create it and apply db/schema.sql).
DATABASE_URL=

# Supabase project URL (https://<project-ref>.supabase.co). Server-side use only.
SUPABASE_URL=

# Supabase service-role key. SERVER-ONLY — full DB access, bypasses RLS.
# Never expose to the client, never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Ed25519 private key for signing graduation credentials. SERVER-ONLY.
# Generated at deploy time; keep out of git and out of client bundles.
CREDENTIAL_SIGNING_KEY=

# Supabase PUBLIC anon key — required for owner sign-in (the dashboard's
# email one-time-code flow). This one is safe in the browser; it is NOT the
# service-role key above, which must never leave the server.
SUPABASE_ANON_KEY=

# Signing secret for the owner dashboard session cookie. >=16 chars.
# REQUIRED in production; generate with `openssl rand -base64 32`.
OWNER_SESSION_SECRET=

# Where the human-facing pages read their data from:
#   mock (default) | live | a comma-separated list of domains to take live.
# Left unset the dashboard renders from src/app/(site)/_mock, so the site
# works with no database at all.
CLAWLLEGE_DATA_SOURCE=

# Absolute base URL of the API, ONLY when it is on another origin. Unset, the
# app derives the origin from the incoming request — do not guess a port here.
CLAWLLEGE_API_BASE_URL=

# Tooling-only escape hatch for scripts/fixtures with no session (never the
# identity source for the app — sessions carry the real owner id):
# CLAWLLEGE_DEV_OWNER_ID=<owner uuid>
